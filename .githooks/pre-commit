#!/usr/bin/env bash
# Pre-commit hook. Turn it on once per clone with `make hooks`
# (which runs `git config core.hooksPath .githooks`).
#
# This is the fast local layer; CI (.github/workflows/checks.yml) runs the
# same checks plus the slow ones and is the real gate. See CONTRIBUTING.md.
# The hook stages one thing itself: the regenerated docs/adr/index/.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
export PATH="$PATH:$(go env GOPATH)/bin"

step() { printf '\n== %s\n' "$1"; }
fail() { printf '\n%s\n' "$1"; exit 1; }

step "gofmt"
staged_go=$(git diff --cached --name-only --diff-filter=ACM -- '*.go')
if [ -n "$staged_go" ]; then
  unformatted=$(printf '%s\n' "$staged_go" | tr '\n' '\0' | xargs -0 gofmt -l)
  if [ -n "$unformatted" ]; then
    printf '%s\n' "$unformatted"
    fail "These files are not gofmt-formatted. Run: gofmt -w <file>, then git add and commit again."
  fi
fi

# First, so that on an import cycle the Polylith rule speaks before the compiler.
step "Polylith check (brick boundaries and layout)"
go run ./tools/poly check

# vet type-checks every package without linking, so nothing is written to disk.
step "go vet ./..."
go vet ./...

# The same Polylith rules as poly check, reported at the import with file:line.
step "go vet -vettool=polyvet ./..."
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
go build -o "$tmp/polyvet" ./tools/polyvet && go vet -vettool="$tmp/polyvet" ./...

step "go test ./..."
go test ./...

step "ADR lint"
go run ./tools/poly adr lint

if git diff --cached --name-only -- 'docs/adr/*.md' | grep -q .; then
  step "ADR index (regenerated and staged for you)"
  go run ./tools/poly adr index
  git add docs/adr/index
fi

step "Interface change heads-up (does not block locally; CI does)"
go run ./tools/poly interface --mode pre-commit

step "golangci-lint"
if ! command -v golangci-lint >/dev/null 2>&1; then
  fail "golangci-lint is not on PATH (looked in \$PATH and $(go env GOPATH)/bin). It is required: https://golangci-lint.run/docs/welcome/install/"
fi
golangci-lint run

printf '\nBefore you let this commit land: walk the "Pre-commit checklist" in AGENTS.md (test for the behaviour, ADR for the decision, prose still true, scratch removed).\n'
